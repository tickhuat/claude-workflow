{
  "permissions": {
    "allow": [
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(coverage *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(poetry *)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(flake8 *)",
      "Bash(isort *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(make *)",
      "Bash(bash *)",
      "Bash(sh *)",
      "Bash(chmod *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(ln *)",
      "Bash(tee *)",
      "Bash(tar *)",
      "Bash(unzip *)",
      "Bash(zip *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git reset *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git clone *)",
      "Bash(git tag *)",
      "Bash(git config *)",
      "Bash(gh *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      { "command": "python3 .claude/scripts/on_user_prompt.py" }
    ],
    "PreToolUse": [
      { "matcher": "Skill", "command": "python3 .claude/scripts/pre_skill.py" },
      { "matcher": "Edit|Write|MultiEdit", "command": "python3 .claude/scripts/pre_edit.py" },
      { "matcher": "Bash", "command": "python3 .claude/scripts/pre_bash.py" }
    ],
    "PostToolUse": [
      { "matcher": "Skill|Agent", "command": "python3 .claude/scripts/post_skill.py" },
      { "matcher": "Edit|Write|MultiEdit", "command": "python3 .claude/scripts/post_edit.py" }
    ]
  }
}
